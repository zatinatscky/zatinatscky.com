# Локальный запуск только hiphop (из каталога hiphop/):
#   cp .env.example .env && docker compose up --build
#
# На VPS секреты задаются в КОРНЕВОМ ~/zatinatscky/.env:
#   HIPHOP_POSTGRES_PASSWORD, OPENAI_API_KEY, DEEPSEEK_API_KEY
# (см. корневой .env.example). Этот файл для изолированной разработки.

# --- PostgreSQL (отдельная БД rhyme_analyzer, не IVAN) ---
POSTGRES_USER=hiphop
POSTGRES_DB=hiphop
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# --- LLM (хотя бы один ключ) ---
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
