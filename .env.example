# Шаблон переменных для docker-compose (корень репозитория).
#   cp .env.example .env  &&  nano .env
# Файл .env НЕ коммитится (см. .gitignore).
# Compose читает только этот файл: ключи hiphop тоже задаются здесь.

# --- PostgreSQL ---
POSTGRES_USER=ivan
POSTGRES_DB=zatinatscky
# Длинный случайный пароль. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# --- Приложение ---
# Host, на котором / отдаёт welcome IVAN (а не визитку).
DASH_ROOT_HOST=ivan.zatinatscky.com
# Публичный URL терминала (без слэша в конце). Нужен для Google OAuth redirect_uri
# и для Secure-флага cookie сессии.
PUBLIC_BASE_URL=https://ivan.zatinatscky.com
# Подпись cookie-сессий. Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# Токен для эндпоинта синхронизации /jobs/fng-sync. Сгенерировать: openssl rand -hex 32
CRON_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# --- Auth: Google OAuth ---
# Создать OAuth 2.0 Client (Web) в Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   https://ivan.zatinatscky.com/api/auth/google/callback
# Пока пусто — кнопка Google в UI скрыта.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth: Telegram Login Widget ---
# 1) Создать бота у @BotFather, взять token и username.
# 2) Привязать домен к боту: /setdomain → ivan.zatinatscky.com
# Пока пусто — кнопка Telegram в UI скрыта.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Telegram channel feed (дневные карточки индексов) ---
# Один бот — админ во всех 14 каналах (+ опционально hub для summary).
# Каждый индекс → свой канал: TELEGRAM_CHANNEL_<ID>=@username или -100…
# Альтернатива одной строкой JSON:
#   TELEGRAM_CHANNELS={"fng":"@ivan_fng","vix":"@ivan_vix",...}
TELEGRAM_CHANNEL_FNG=
TELEGRAM_CHANNEL_ALTSEASON=
TELEGRAM_CHANNEL_BVOL=
TELEGRAM_CHANNEL_NUPL=
TELEGRAM_CHANNEL_SSR=
TELEGRAM_CHANNEL_FUNDING=
TELEGRAM_CHANNEL_MVRV=
TELEGRAM_CHANNEL_VIX=
TELEGRAM_CHANNEL_SPX=
TELEGRAM_CHANNEL_NIKKEI=
TELEGRAM_CHANNEL_CNNFNG=
TELEGRAM_CHANNEL_BRENT=
TELEGRAM_CHANNEL_US10Y=
TELEGRAM_CHANNEL_DXY=
# Опционально: дневной summary (movers). Можно оставить старый TELEGRAM_CHANNEL_ID.
TELEGRAM_SUMMARY_CHANNEL_ID=
TELEGRAM_CHANNEL_ID=
# false — полностью выключить постинг.
TELEGRAM_FEED_ENABLED=true

# --- hiphop (rhyme_analyzer) ---
# Пароль отдельной БД hiphop (не тот же, что POSTGRES_PASSWORD IVAN).
# openssl rand -hex 24
HIPHOP_POSTGRES_PASSWORD=CHANGE_ME_HIPHOP_DB_PASSWORD
# Хотя бы один LLM-ключ для разбора рифм.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Число воркеров gunicorn hiphop-web (анализ долгий — обычно 1).
GUNICORN_WORKERS=1
