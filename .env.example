# Шаблон переменных для docker-compose. Скопируйте в .env и подставьте секреты:
#   cp .env.example .env  &&  nano .env
# Файл .env НЕ коммитится (см. .gitignore).

# --- PostgreSQL ---
POSTGRES_USER=ivan
POSTGRES_DB=zatinatscky
# Длинный случайный пароль. Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# --- Приложение ---
# Host, на котором / отдаёт welcome IVAN (а не визитку).
DASH_ROOT_HOST=ivan.zatinatscky.com
# Публичный URL терминала (без слэша в конце). Нужен для Google OAuth redirect_uri
# и для Secure-флага cookie сессии.
PUBLIC_BASE_URL=https://ivan.zatinatscky.com
# Подпись cookie-сессий. Сгенерировать: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# Токен для эндпоинта синхронизации /jobs/fng-sync. Сгенерировать: openssl rand -hex 32
CRON_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# --- Auth: Google OAuth ---
# Создать OAuth 2.0 Client (Web) в Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   https://ivan.zatinatscky.com/api/auth/google/callback
# Пока пусто — кнопка Google в UI скрыта.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Auth: Telegram Login Widget ---
# 1) Создать бота у @BotFather, взять token и username.
# 2) Привязать домен к боту: /setdomain → ivan.zatinatscky.com
# Пока пусто — кнопка Telegram в UI скрыта.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
